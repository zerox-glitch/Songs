  "lyrics": [
    {
      "start": 12.0,
      "end": 17.6,
      "text": "The morning light is breaking in Lahore,"
    },
    {
      "start": 18.78,
      "end": 21.25,
      "text": "While midnight settles on your distant shore."
    },
    {
      "start": 21.26,
      "end": 25.57,
      "text": "I know you're pulling down the window blinds,"
    },
    {
      "start": 25.58,
      "end": 29.3,
      "text": "And leaving all the heavy day behind."
    },
    {
      "start": 29.31,
      "end": 32.37,
      "text": "I trace the little pixels on the screen,"
    },
    {
      "start": 33.45,
      "end": 38.19,
      "text": "The most beautiful face I've ever seen."
    },
    {
      "start": 44.0,
      "end": 49.0,
      "text": "A half a world away, a different sky..."
    },
    {
      "start": 49.0,
      "end": 54.0,
      "text": "But I can hear the softness in your sigh..."
    },
    {
      "start": 56.0,
      "end": 61.5,
      "text": "I will keep the fire burning till you come back home!"
    },
    {
      "start": 61.5,
      "end": 67.0,
      "text": "You never have to walk this heavy road alone!"
    },
    {
      "start": 67.0,
      "end": 72.5,
      "text": "I carry every promise that we ever made!"
    },
    {
      "start": 72.5,
      "end": 78.0,
      "text": "A quiet kind of love that never fades!"
    },
    {
      "start": 78.0,
      "end": 82.0,
      "text": "Aaaahhh huh haaaa!"
    },
    {
      "start": 82.0,
      "end": 86.0,
      "text": "Laaa la la laaaa!"
    },
    {
      "start": 91.0,
      "end": 96.0,
      "text": "I leave the phone right next to me in bed,"
    },
    {
      "start": 96.0,
      "end": 101.0,
      "text": "Just so I can hear you breathing deep."
    },
    {
      "start": 101.0,
      "end": 106.0,
      "text": "It closes up the thousands of miles,"
    },
    {
      "start": 106.0,
      "end": 111.0,
      "text": "To know I'm right beside you when you sleep."
    },
    {
      "start": 111.0,
      "end": 116.0,
      "text": "We share the day and pass the sun along,"
    },
    {
      "start": 116.0,
      "end": 121.0,
      "text": "You are the only place where I belong."
